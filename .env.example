# Run without credentials first: deterministic demo mode keeps the UI usable.
APP_ENV=local
APP_NAME=TrackoBit Support Assistant
API_HOST=127.0.0.1
API_PORT=8000
UI_API_BASE_URL=http://127.0.0.1:8000

# Set LLM_PROVIDER=openai (or anthropic) and the corresponding API key to enable
# model-backed intent parsing, RAG synthesis and screenshot interpretation.
LLM_PROVIDER=mock
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_VISION_MODEL=gpt-4o-mini
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5
ANTHROPIC_VISION_MODEL=claude-sonnet-4-5
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=trackobit-support-local

DATA_DIR=./data
SESSION_DIR=./data/sessions
UPLOAD_DIR=./data/uploads
KNOWLEDGE_DIR=./data/knowledge_base
COMMANDS_DIR=./data/commands

# Vehicle detail API configuration
# Use VEHICLE_API_URL_TEMPLATE with {vehicle_number} placeholder and API_AUTH_TOKEN (JWT / Bearer token)
VEHICLE_API_URL_TEMPLATE=
API_AUTH_TOKEN=
# Or use legacy base URL + path + key
VEHICLE_API_BASE_URL=
VEHICLE_API_KEY=
VEHICLE_API_PATH=/vehicles/{vehicle_no}/status
VEHICLE_API_TIMEOUT_SECONDS=8

# Leave blank to use the local mock ticket adapter. This is a generic HTTP contract, not a Jira-specific integration.
TICKET_API_URL=
TICKET_API_KEY=
TICKET_API_TIMEOUT_SECONDS=10
VEHICLE_NO_REGEX=^[A-Z]{2}\d{1,2}[A-Z]{0,3}\d{4}$
INTENT_CONFIDENCE_THRESHOLD=0.65
QUERY_CONFIDENCE_THRESHOLD=0.60
RAG_CONFIDENCE_THRESHOLD=0.60
FRESHNESS_THRESHOLD_MINUTES=10
MAX_INPUT_RETRIES=3
MAX_TROUBLESHOOT_ROUNDS=2
MAX_UNREADABLE_SCREENSHOT_RETRIES=2
PAUSED_FRAME_TTL_MINUTES=60
PAUSED_FRAME_MAX_AGE_HOURS=72
APP_TIMEZONE=Asia/Kolkata
ASSIGN_TO_SUPPORT_USER=trackobit-support
# Comma-separated node=version entries, e.g. intent_parser=v2,rag_answer=v1
PROMPT_VERSIONS=
